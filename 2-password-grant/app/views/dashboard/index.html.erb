<h1>Dashboard</h1>
<p>
  You must be authenticated to see this page so if you're seeing it then
  everything worked as expected 🎉
</p>

<%= button_to "Log Out", destroy_session_path, method: :delete %>

<h2>Current User</h2>

<% current_user.each do |k, v| %>
  <div class="profile">
    <span><%= k %>:</span> <%= v %>
  </div>
<% end %>
